# Bu dosya Git'e GIRER, .env GIRMEZ.
# Amaci: projeyi klonlayan kisinin HANGI anahtarlarin gerektigini bilmesi.
# Kullanim:  cp .env.example .env  ve degerleri doldur.

# --- PostgreSQL ---
POSTGRES_USER=kullaniciadi
POSTGRES_PASSWORD=guclu-bir-parola
POSTGRES_DB=oyunkutuphanesi

# --- JWT (container / Production) ---
# Anahtari uretmek icin:  openssl rand -base64 48
JWT_ANAHTAR=en-az-32-karakterlik-rastgele-bir-deger
JWT_YAYINCI=IlkApi
JWT_HEDEF=IlkApiIstemcileri
